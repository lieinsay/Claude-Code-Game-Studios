<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>CloudWeaverVoyage</RootNamespace>
    <AssemblyName>CloudWeaverVoyage</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <!-- Godot node scripts: compiled by Godot editor project only, not dotnet build -->
    <Compile Remove="src/debug/RegistryDiagnosticPanel.cs" />
    <Compile Remove="src/scenes/SessionShell.cs" />
  </ItemGroup>
</Project>
