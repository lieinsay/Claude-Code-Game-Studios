<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>bin\FirstLoopRegressionTest\</OutputPath>
    <UseAppHost>false</UseAppHost>
    <GodotProjectDir>$(MSBuildThisFileDirectory)..\..\..\</GodotProjectDir>
    <GodotProjectDirBase64>$([MSBuild]::ConvertToBase64('$(GodotProjectDir)'))</GodotProjectDirBase64>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="GodotProjectDir" />
    <CompilerVisibleProperty Include="GodotProjectDirBase64" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="FirstLoopRegressionProgram.cs" />
    <ProjectReference Include="..\..\..\CloudWeaverVoyage.csproj" />
  </ItemGroup>
</Project>
